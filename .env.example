# ===================================================================
# Configuración de la API Backend (FastAPI)
# ===================================================================

# Conexión a MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pdf_extractor

# Configuración de la aplicación
APP_NAME="PDF Extractor API"
APP_VERSION="0.2.0"
DEBUG=false

# ===================================================================
# Configuración de Docker Compose / Traefik
# ===================================================================

# Dominios para Traefik (separación de frontend y backend)
BACKEND_HOST=extract.universidad.localhost
FRONTEND_HOST=universidad.localhost

# Si usas Imagen Docker precompilada (opcional)
# API_IMAGE=ghcr.io/tu-usuario/pdf-extractortext-api
# API_VERSION=latest
