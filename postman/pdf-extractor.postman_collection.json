{
  "info": {
    "_postman_id": "f65c8e8b-2c4a-4b8a-9b3c-7d9e0f1a2b3c",
    "name": "PDF Extractor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for testing the PDF Extractor API microservice - extraction, CRUD operations, and health checks"
  },
  "item": [
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload PDF Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data",
                "type": "text"
              }
            ],
            "body": {
              "mode": "form-data",
              "form": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "PDF file to extract text from"
                }
              ]
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/documents/upload",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "upload"
              ]
            }
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/api/v1/documents/",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            }
          }
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/api/v1/documents/{{document_id}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{document_id}}"
              ]
            }
          }
        },
        {
          "name": "Update Document Text",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extracted_text\": \"<your extracted text here>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/v1/documents/{{document_id}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{document_id}}"
              ]
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/api/v1/documents/{{document_id}}",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{document_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base_url}}/api/v1/health",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Frontend",
      "item": [
        {
          "name": "Get Frontend UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Obtiene la interfaz de usuario del microservicio front-end (index.html)"
          }
        },
        {
          "name": "Get Frontend Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Health check del microservicio front-end estático servido por Nginx"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "api_base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "65c4c3e1a8d5e2f0b8a0b9c1d2e3f4a5b6c7d8e9",
      "type": "string"
    },
    {
      "key": "traefik_url",
      "value": "https://extract.universidad.localhost",
      "type": "string"
    },
    {
      "key": "environment",
      "value": "local",
      "type": "string"
    }
  ]
}
